rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCaller(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Handshake test document
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }

    // Authenticated users profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Complexes collection (المجمعات القرآنية)
    match /complexes/{complexId} {
      allow read: if true; // Public list for discovery and branding
      allow create, update: if isValidId(complexId)
        && (incoming().name is string || (resource != null && resource.data.name is string));
      allow delete: if isValidId(complexId);
    }

    // Halaqahs collection
    match /halaqahs/{halaqahId} {
      allow read: if true;
      allow create, update: if isValidId(halaqahId)
        && (incoming().name is string || (resource != null && resource.data.name is string));
      allow delete: if isValidId(halaqahId);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId)
        && (incoming().name is string || (resource != null && resource.data.name is string));
      allow delete: if isValidId(studentId);
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if isValidId(attendanceId)
        && incoming().studentId is string
        && incoming().date is string
        && incoming().status in ['حاضر', 'غائب', 'معتذر', 'متأخر', 'مستأذن'];
      allow delete: if isValidId(attendanceId);
    }

    // Evaluations
    match /evaluations/{evaluationId} {
      allow read: if true;
      allow create, update: if isValidId(evaluationId)
        && incoming().studentId is string
        && incoming().date is string;
      allow delete: if isValidId(evaluationId);
    }

    // Criteria
    match /criteria/{criteriaId} {
      allow read: if true;
      allow create, update: if isValidId(criteriaId)
        && incoming().name is string;
      allow delete: if isValidId(criteriaId);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Teachers & Accounts collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isValidId(teacherId)
        && incoming().name is string;
      allow delete: if isValidId(teacherId);
    }

    // Chats with Quran AI Coach
    match /chats/{chatId} {
      allow read, write: if isValidId(chatId);
    }

    // Behavioral Violations & Pedagogical Guidance
    match /violations/{violationId} {
      allow read: if true;
      allow create, update: if isValidId(violationId)
        && incoming().studentId is string;
      allow delete: if isValidId(violationId);
    }

    // Quran Exams & Quizzes
    match /exams/{examId} {
      allow read: if true;
      allow create, update: if isValidId(examId)
        && incoming().title is string;
      allow delete: if isValidId(examId);
    }

    // Exam Submissions
    match /exam_submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isValidId(submissionId)
        && incoming().studentId is string;
      allow delete: if isValidId(submissionId);
    }

    // Surah Recordings
    match /surah_recordings/{recordingId} {
      allow read, write: if isValidId(recordingId);
    }

    // Student Listening Logs
    match /listening_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId)
        && incoming().studentId is string;
      allow delete: if isValidId(logId);
    }

    // Issued Certificates collection
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isValidId(certificateId)
        && incoming().studentId is string;
      allow delete: if isValidId(certificateId);
    }

    // Teacher Attendance records
    match /teacher_attendance/{attId} {
      allow read: if true;
      allow create, update: if isValidId(attId)
        && incoming().teacherId is string;
      allow delete: if isValidId(attId);
    }

    // Teacher Shifts
    match /teacher_shifts/{shiftId} {
      allow read: if true;
      allow create, update: if isValidId(shiftId)
        && incoming().name is string;
      allow delete: if isValidId(shiftId);
    }

    // Mosques collection
    match /mosques/{mosqueId} {
      allow read: if true;
      allow create, update: if isValidId(mosqueId)
        && incoming().name is string;
      allow delete: if isValidId(mosqueId);
    }

    // Library Documents & Archive collection
    match /library_docs/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId)
        && incoming().title is string;
      allow delete: if isValidId(docId);
    }

    // Student Registration Applications (طلبات الانضمام وبوابة المجمع)
    match /registration_applications/{appId} {
      allow read: if true;
      allow create, update: if isValidId(appId)
        && incoming().studentName is string;
      allow delete: if isValidId(appId);
    }
  }
}
